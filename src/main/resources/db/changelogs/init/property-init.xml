<changeSet id="003-create-property-table" author="lopatenko">
    <createTable tableName="property">
        <column name="id" type="BIGINT" autoIncrement="true">
            <constraints primaryKey="true" nullable="false"/>
        </column>
        <column name="product_id" type="BIGINT">
            <constraints nullable="false" foreignKeyName="fk_property_product" referencedTableName="product" referencedColumnNames="id"/>
        </column>
        <column name="prop_name" type="VARCHAR(255)">
            <constraints nullable="false"/>
        </column>
        <column name="prop_value" type="VARCHAR(255)">
            <constraints nullable="false"/>
        </column>
    </createTable>

    <createIndex indexName="idx_property_product_id" tableName="property">
        <column name="product_id"/>
    </createIndex>

    <sql>
        INSERT INTO dbo.tables (db, name, type, author, version, service, description, column_count, created_at, last_update_at)
        VALUES ('liquibase_lab', 'property', 'DATA_TABLE', 'lopatenko', 1, 'PRODUCT_SERVICE', 'Table for storing product properties.', 
        (SELECT COUNT(*) FROM sys.columns WHERE object_id = OBJECT_ID('property')), SYSUTCDATETIME(), NULL);
    </sql>

    <rollback>
        <sql>DELETE FROM dbo.tables WHERE name = 'property';</sql>
        <dropTable tableName="property"/>
    </rollback>
</changeSet>
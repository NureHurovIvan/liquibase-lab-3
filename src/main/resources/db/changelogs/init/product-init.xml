<changeSet id="002-create-product-table" author="lopatenko">
    <createTable tableName="product">
        <column name="id" type="BIGINT" autoIncrement="true">
            <constraints primaryKey="true" nullable="false"/>
        </column>
        <column name="category_id" type="BIGINT">
            <constraints nullable="false" foreignKeyName="fk_product_category" referencedTableName="category" referencedColumnNames="id"/>
        </column>
        <column name="name" type="VARCHAR(255)">
            <constraints nullable="false"/>
        </column>
        <column name="price" type="DECIMAL(10, 2)">
            <constraints nullable="false"/>
        </column>
    </createTable>

    <createIndex indexName="idx_product_category_id" tableName="product">
        <column name="category_id"/>
    </createIndex>

    <sql>
        INSERT INTO dbo.tables (db, name, type, author, version, service, description, column_count, created_at, last_update_at)
        VALUES ('liquibase_lab', 'product', 'DATA_TABLE', 'lopatenko', 1, 'PRODUCT_SERVICE', 'Table for storing products catalog.', 
        (SELECT COUNT(*) FROM sys.columns WHERE object_id = OBJECT_ID('product')), SYSUTCDATETIME(), NULL);
    </sql>

    <rollback>
        <sql>DELETE FROM dbo.tables WHERE name = 'product';</sql>
        <dropTable tableName="product"/>
    </rollback>
</changeSet>
<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-user_roles-table" author="Hurov">
        <createTable tableName="user_roles">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_roles"/>
            </column>
            <column name="role_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_roles"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="user_roles" baseColumnNames="user_id"
                                 constraintName="fk_user_roles_users"
                                 referencedTableName="users" referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="user_roles" baseColumnNames="role_id"
                                 constraintName="fk_user_roles_roles"
                                 referencedTableName="roles" referencedColumnNames="id"/>

        <sql>
            INSERT INTO dbo.tables (db_, name, type, author, version, service, description, column_count, created_at)
            VALUES ('liquibase_lab', 'user_roles', 'DATA_TABLE', 'Hurov', 1, 'USER_SERVICE', 'Link table between users and roles',
                    (SELECT COUNT(*) FROM sys.columns WHERE object_id = OBJECT_ID('user_roles')), SYSUTCDATETIME());
        </sql>

        <rollback>
            <sql>DELETE FROM dbo.tables WHERE name = 'user_roles';</sql>
            <dropTable tableName="user_roles"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd">

    <changeSet id="004-create-log-trigger" author="Khudanova">
        <preConditions onFail="HALT">
            <tableExists tableName="log"/>
        </preConditions>

        <sql splitStatements="false">
            CREATE TRIGGER trg_PreventLogUpdate
            ON log
            FOR UPDATE
            AS
            BEGIN
                RAISERROR ('Log records are immutable and cannot be updated!', 16, 1);
                ROLLBACK TRANSACTION;
            END;
        </sql>

        <rollback>
            <sql>DROP TRIGGER IF EXISTS trg_PreventLogUpdate;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
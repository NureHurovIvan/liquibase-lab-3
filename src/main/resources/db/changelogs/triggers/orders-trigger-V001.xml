<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd">

    <changeSet id="004-create-order-trigger" author="Tiulieniev">
        <preConditions onFail="HALT">
            <tableExists tableName="orders"/>
        </preConditions>

        <sql splitStatements="false">
            CREATE TRIGGER trg_PreventDeleteCompletedOrder
            ON orders
            FOR DELETE
            AS
            BEGIN
                IF EXISTS (SELECT 1 FROM deleted WHERE status_id = 3)
                BEGIN
                    RAISERROR ('Cannot delete completed orders!', 16, 1);
                    ROLLBACK TRANSACTION;
                END
            END;
        </sql>

        <rollback>
            <sql>DROP TRIGGER IF EXISTS trg_PreventDeleteCompletedOrder;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
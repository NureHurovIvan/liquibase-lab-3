<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd">

    <changeSet id="005-drop-product-basket-table" author="Khudanova">
        <preConditions onFail="HALT">
            <tableExists tableName="product_basket"/>
        </preConditions>

        <dropTable tableName="product_basket"/>

        <sql>
            DELETE FROM dbo.tables WHERE name = 'product_basket';
        </sql>

        <rollback>
            <createTable tableName="product_basket">
                <column name="basket_id" type="int"><constraints nullable="false"/></column>
                <column name="product_id" type="int"><constraints nullable="false"/></column>
                <column name="quantity" type="int"><constraints nullable="false"/></column>
            </createTable>
            <addPrimaryKey tableName="product_basket" columnNames="basket_id, product_id" constraintName="PK_product_basket"/>
            <addForeignKeyConstraint baseTableName="product_basket" baseColumnNames="basket_id" constraintName="FK_product_basket_basket" referencedTableName="basket" referencedColumnNames="id"/>
            <sql>
                INSERT INTO dbo.tables (db_, name, type, author, version, service, description, column_count, created_at, last_update_at)
                VALUES ('liquibase_lab', 'product_basket', 'DATA_TABLE', 'Khudanova', 1, 'basket_service', 'Items in basket', 3, SYSUTCDATETIME(), NULL);
            </sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
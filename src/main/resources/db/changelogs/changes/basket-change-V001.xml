<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.15.xsd">

    <changeSet id="003-add-denorm-column-basket" author="Khudanova">
        <preConditions onFail="HALT">
            <tableExists tableName="log"/>
        </preConditions>

        <addColumn tableName="log">
            <column name="basket_snapshot_json" type="nvarchar(max)"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="log" columnName="basket_snapshot_json"/>
        </rollback>
    </changeSet>

</databaseChangeLog>